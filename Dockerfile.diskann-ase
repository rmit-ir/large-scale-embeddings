FROM docker.io/rankun203/diskann:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    python3-venv \
    build-essential \
    cmake \
    ninja-build \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

RUN python -m pip install --no-cache-dir \
    numpy \
    torch --index-url https://download.pytorch.org/whl/cu130 \
  && python -m pip install --no-cache-dir \
    transformers==4.57.6 \
    sentencepiece \
    protobuf \
    diskannpy

COPY cloud/dockerfiles/torch-cuda-entrypoint.sh /usr/local/bin/torch-cuda-entrypoint.sh
RUN chmod 755 /usr/local/bin/torch-cuda-entrypoint.sh

# check and fix torch<>cuda compatibility
# check and install necessary NVCC toolkits (download 3GB)
ENTRYPOINT ["/usr/local/bin/torch-cuda-entrypoint.sh"]
WORKDIR /app/large-scale-embeddings
