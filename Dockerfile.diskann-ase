FROM diskann:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    build-essential \
    cmake \
    ninja-build \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip \
  && python3 -m pip install --no-cache-dir \
    numpy \
    "torch==2.10.0" --index-url https://download.pytorch.org/whl/cpu \
  && python3 -m pip install --no-cache-dir \
    "transformers==4.37.2" \
    sentencepiece \
    protobuf \
    diskannpy

COPY cloud/dockerfiles/torch-cuda-entrypoint.sh /usr/local/bin/torch-cuda-entrypoint.sh
RUN chmod 755 /usr/local/bin/torch-cuda-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/torch-cuda-entrypoint.sh"]
WORKDIR /app/large-scale-embeddings
